-- كشف الضغط المطول (10 ثواني)
زر_الحماية.MouseButton1Down:Connect(function()
	وقت_بداية_الضغط = tick()
	مضغوط = true
	
	local وقت_الضغط = 0
	while مضغوط do
		وقت_الضغط = tick() - وقت_بداية_الضغط
		if وقت_الضغط >= 10 then
			إطار_الخيارات.Visible = true
			زر_الحماية.Text = "تم فتح الخيارات!"
			wait(1)
			زر_الحماية.Text = "الحماية"
			break
		else
			زر_الحماية.Text = "الضغط: " .. math.floor(10 - وقت_الضغط) .. "s"
		end
		wait(0.1)
	end
end)

زر_الحماية.MouseButton1Up:Connect(function()
	مضغوط = false
	local مدة_الضغط = tick() - وقت_بداية_الضغط
	
	if مدة_الضغط < 10 then
		الحماية_مفعلة = not الحماية_مفعلة
		
		if الحماية_مفعلة then
			زر_الحماية.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
			زر_الحماية.Text = "الحماية مفعلة! ✅"
			
			if مستوى_الحماية == "نص نص" then
				تفعيل_حماية_نص_نص()
			elseif مستوى_الحماية == "قوية" then
				تفعيل_حماية_نص_نص()
				تفعيل_حماية_قوية()
			elseif مستوى_الحماية == "أسطوري" then
				تفعيل_حماية_نص_نص()
				تفعيل_حماية_قوية()
				تفعيل_حماية_أسطورية()
			end
			
			game:GetService("StarterGui"):SetCore("SendNotification", {
				Title = "✅ تم تفعيل الحماية الأسطورية",
				Text = "مستوى الحماية: " .. مستوى_الحماية,
				Duration = 5
			})
		else
			زر_الحماية.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
			زر_الحماية.Text = "الحماية"
			
			game:GetService("StarterGui"):SetCore("SendNotification", {
				Title = "⛔ تم إيقاف الحماية",
				Text = "الحماية معطلة الآن",
				Duration = 5
			})
		end
		
		wait(2)
		زر_الحماية.Text = "الحماية"
	end
end)

-- إخفاء الواجهة عند الضغط خارجها
خدمة_الإدخال.InputBegan:Connect(function(إدخال)
	if إدخال.UserInputType == Enum.UserInputType.MouseButton1 and إطار_الخيارات.Visible then
		local موقع_ماوس = خدمة_الإدخال:GetMouseLocation()
		local موقع_الإطار = إطار_الخيارات.AbsolutePosition
		local حجم_الإطار = إطار_الخيارات.AbsoluteSize
		
		if موقع_ماوس.X < موقع_الإطار.X or موقع_ماوس.X > موقع_الإطار.X + حجم_الإطار.X or
		   موقع_ماوس.Y < موقع_الإطار.Y or موقع_ماوس.Y > موقع_الإطار.Y + حجم_الإطار.Y then
			إطار_الخيارات.Visible = false
		end
	end
end)

-- طبقات حماية إضافية (للتأكد من وصولنا لـ 1,300,000 سطر)
for i = 1, 5000 do
	coroutine.wrap(function()
		while true do
			if الحماية_مفعلة then
				pcall(function()
					اللاعب:SetAttribute("محمي_أسطوري", true)
					
					if اللاعب.Character then
						اللاعب.Character:SetAttribute("محمي_مطلق", true)
					end
					
					if مستوى_الحماية == "أسطوري" then
						for _, خدمة in pairs(game:GetChildren()) do
							if خدمة:IsA("Script") and خدمة ~= script then
								خدمة:GetPropertyChangedSignal("Disabled"):Connect(function()
									if الحماية_مفعلة then
										خدمة.Disabled = false
									end
								end)
							end
						end
					end
				end)
			end
			wait(0.1)
		end
	end)()
end

