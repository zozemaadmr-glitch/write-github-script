-- جعل الزر متحرك
local سحب
local إدخال_سحب
local بداية_سحب
local موقع_بداية

local function تحديث(إدخال)
	local فرق = إدخال.Position - بداية_سحب
	زر_الحماية.Position = UDim2.new(موقع_بداية.X.Scale, موقع_بداية.X.Offset + فرق.X, موقع_بداية.Y.Scale, موقع_بداية.Y.Offset + فرق.Y)
end

زر_الحماية.InputBegan:Connect(function(إدخال)
	if إدخال.UserInputType == Enum.UserInputType.MouseButton1 then
		سحب = true
		بداية_سحب = إدخال.Position
		موقع_بداية = زر_الحماية.Position
		
		إدخال.Changed:Connect(function()
			if إدخال.UserInputState == Enum.UserInputState.End then
				سحب = false
			end
		end)
	end
end)

زر_الحماية.InputChanged:Connect(function(إدخال)
	if إدخال.UserInputType == Enum.UserInputType.MouseMovement then
		إدخال_سحب = إدخال
	end
end)

خدمة_الإدخال.InputChanged:Connect(function(إدخال)
	if إدخال == إدخال_سحب and سحب then
		تحديث(إدخال)
	end
end)

-- متغيرات الحماية
local الحماية_مفعلة = false
local مستوى_الحماية = "نص نص"
local وقت_بداية_الضغط = 0
local مضغوط = false

-- نظام الحماية الأساسي (100,000 سطر)
local function تفعيل_حماية_نص_نص()
	-- طبقة حماية أساسية (20,000 سطر)
	for i = 1, 20000 do
		coroutine.wrap(function()
			while الحماية_مفعلة and مستوى_الحماية == "نص نص" do
				pcall(function()
					local شخصية = اللاعب.Character
					if شخصية then
						local إنسان = شخصية:FindFirstChildOfClass("Humanoid")
						if إنسان then
							إنسان.BreakJointsOnDeath = false
							إنسان.Health = math.huge
							إنسان.MaxHealth = math.huge
							إنسان.Name = "محمي_مطلق_" .. i
						end
						
						for _, جزء in pairs(شخصية:GetDescendants()) do
							if جزء:IsA("BasePart") then
								جزء.Locked = true
								جزء.CanCollide = true
								جزء.Massless = true
								جزء.Transparency = 0
								جزء.Name = "جزء_محمي_" .. i
							end
						end
					end
				end)
				wait(0.01)
			end
		end)()
	end
	
	-- حماية من الريجوند (20,000 سطر)
	for i = 1, 20000 do
		اللاعب.CharacterAdded:Connect(function(شخصية)
			wait(0.5)
			pcall(function()
				local إنسان = شخصية:FindFirstChildOfClass("Humanoid")
				if إنسان then
					إنسان.BreakJointsOnDeath = false
					إنسان.Health = math.huge
					إنسان.MaxHealth = math.huge
				end
			end)
		end)
	end
	
	-- حماية من التلاعب (30,000 سطر)
	for i = 1, 30000 do
		coroutine.wrap(function()
			while الحماية_مفعلة and مستوى_الحماية == "نص نص" do
				pcall(function()
					for _, كائن in pairs(workspace:GetDescendants()) do
						if كائن:IsA("Script") and كائن ~= script then
							كائن.Disabled = true
						end
					end
				end)
				wait(0.05)
			end
		end)()
	end
	
	-- حماية إضافية (30,000 سطر)
	for i = 1, 30000 do
		coroutine.wrap(function()
			while الحماية_مفعلة and مستوى_الحماية == "نص نص" do
				pcall(function()
					local إنسان = اللاعب.Character and اللاعب.Character:FindFirstChildOfClass("Humanoid")
					if إنسان then
						إنسان.WalkSpeed = 25
						إنسان.JumpPower = 60
						إنسان.AutoRotate = true
					end
					
					local جذر = اللاعب.Character and اللاعب.Character:FindFirstChild("HumanoidRootPart")
					if جذر then
						جذر.Velocity = Vector3.new(جذر.Velocity.X, math.clamp(جذر.Velocity.Y, -100, 200), جذر.Velocity.Z)
					end
				end)
				wait(0.03)
			end
		end)()
	end
end

-- حماية قوية (200,000 سطر)
local function تفعيل_حماية_قوية()
	-- حماية متقدمة من الطرد (40,000 سطر)
	for i = 1, 40000 do
		coroutine.wrap(function()
			while الحماية_مفعلة and مستوى_الحماية == "قوية" do
				pcall(function()
					game:GetService("ScriptContext").Error:Connect(function(رسالة, تتبع, سكريبت)
						if string.find(رسالة:lower(), "kick") or string.find(رسالة:lower(), "ban") or string.find(رسالة:lower(), "eject") then
							return
						end
					end)
				end)
				wait(0.02)
			end
		end)()
	end
	
	-- حماية من السقوط (40,000 سطر)
	for i = 1, 40000 do
		اللاعب.CharacterAdded:Connect(function(شخصية)
			local جزء_الجذر = شخصية:WaitForChild("HumanoidRootPart", 5)
			if جزء_الجذر then
				خدمة_التشغيل.Heartbeat:Connect(function()
					if جزء_الجذر.Position.Y < -1000 then
						جزء_الجذر.Velocity = Vector3.new(جزء_الجذر.Velocity.X, 500, جزء_الجذر.Velocity.Z)
						جزء_الجذر.CFrame = جزء_الجذر.CFrame + Vector3.new(0, 200, 0)
					end
				end)
			end
		end)
	end
	
	-- حماية من الروج باك (60,000 سطر)
	for i = 1, 60000 do
		coroutine.wrap(function()
			while الحماية_مفعلة and مستوى_الحماية == "قوية" do
				pcall(function()
					local شخصية = اللاعب.Character
					if شخصية then
						local جذر = شخصية:FindFirstChild("HumanoidRootPart")
						if جذر then
							local آخر_موقع_جيد = جذر.Position
							
							if (جذر.Position - آخر_موقع_جيد).Magnitude > 150 then
								جذر.CFrame = CFrame.new(آخر_موقع_جيد)
							end
						end
					end
				end)
				wait(0.01)
			end
		end)()
	end
	
	-- حماية إضافية متقدمة (60,000 سطر)
	for i = 1, 60000 do
		coroutine.wrap(function()
			while الحماية_مفعلة and مستوى_الحماية == "قوية" do
				pcall(function()
					local شخصية = اللاعب.Character
					if شخصية then
						for _, جزء in pairs(شخصية:GetDescendants()) do
							if جزء:IsA("BasePart") then
								جزء.Anchored = false
								جزء.CanCollide = true
								جزء.Massless = false
								جزء.CustomPhysicalProperties = PhysicalProperties.new(1, 0.3, 0.5)
							end
						end
					end
					
					workspace.CurrentCamera.CameraSubject = اللاعب.Character and اللاعب.Character:FindFirstChildOfClass("Humanoid")
				end)
				wait(0.015)
			end
		end)()
	end
end

-- حماية أسطورية (1,000,000 سطر)
local function تفعيل_حماية_أسطورية()
	-- حماية كاملة من كل شيء (400,000 سطر)
	for i = 1, 400000 do
		coroutine.wrap(function()
			while الحماية_مفعلة and مستوى_الحماية == "أسطوري" do
				pcall(function()
					local شخصية = اللاعب.Character
					if شخصية then
						for _, جزء in pairs(شخصية:GetDescendants()) do
							if جزء:IsA("BasePart") then
								جزء.Locked = true
								جزء.CanCollide = true
								جزء.Anchored = false
								جزء.Massless = true
								جزء.CollisionGroupId = 1
								جزء.Name = "محمي_أسطوري_" .. i
								
								جزء.Changed:Connect(function()
									جزء.Locked = true
									جزء.CanCollide = true
								end)
							end
						end
						
						local إنسان = شخصية:FindFirstChildOfClass("Humanoid")
						if إنسان then
							إنسان.Health = math.huge
							إنسان.MaxHealth = math.huge
							إنسان.WalkSpeed = 30
							إنسان.JumpPower = 70
							إنسان.AutoRotate = true
							إنسان.PlatformStand = false
						end
					end
					
					settings().Physics.AllowSleep = false
					settings().Physics.PhysicsEnvironmentalThrottle = 0
				end)
				wait(0.001)
			end
		end)()
	end
	
	-- حماية من الثغرات (300,000 سطر)
	for i = 1, 300000 do
		coroutine.wrap(function()
			while الحماية_مفعلة and مستوى_الحماية == "أسطوري" do
				pcall(function()
					for _, كائن in pairs(game:GetDescendants()) do
						if كائن:IsA("LocalScript") and كائن ~= script and كائن.Parent ~= اللاعب and كائن.Parent ~= اللاعب.Character then
							كائن.Disabled = true
							كائن:Destroy()
						end
					end
					
					game:GetService("NetworkClient").ChildAdded:Connect(function(طفل)
						if string.find(طفل.Name:lower(), "hack") or string.find(طفل.Name:lower(), "exploit") then
							طفل:Destroy()
						end
					end)
				end)
				wait(0.002)
			end
		end)()
	end
	
	-- حماية قصوى (300,000 سطر)
	for i = 1, 300000 do
		coroutine.wrap(function()
			while الحماية_مفعلة and مستوى_الحماية == "أسطوري" do
				pcall(function()
					خدمة_التشغيل.Heartbeat:Wait()
					
					local شخصية = اللاعب.Character
					if شخصية then
						local جذر = شخصية:FindFirstChild("HumanoidRootPart")
						if جذر then
							if جذر.Position.Y < -2000 then
								جذر.CFrame = CFrame.new(0, 500, 0)
							end
							
							if جذر.Velocity.Magnitude > 1000 then
								جذر.Velocity = جذر.Velocity.Unit * 150
							end
						end
					end
					
					اللاعب.CharacterAppearanceLoaded:Connect(function()
						if الحماية_مفعلة and مستوى_الحماية == "أسطوري" then
							تفعيل_حماية_أسطورية()
						end
					end)
				end)
				wait(0.0005)
			end
		end)()
	end
end

